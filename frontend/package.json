{
  "name": "soda-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "demo:record": "playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "flag-icons": "^7.5.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "satellite.js": "^6.0.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.12",
    "vuetify": "^3.13.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
